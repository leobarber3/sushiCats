[node name="HowToPlayText2" type="Label" parent="ScreenManager/HowToPlayScreen/ColorRect/TitlePanel/VBoxContainer/Panel/HBoxContainer" unique_id=736835872]
layout_mode = 2
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("3_7hsmw")
theme_override_font_sizes/font_size = 32
text = "Each level involves the same steps and you begin with one starter recipe: onigiri
To cook onigiri you need to place ingredients into the cooking
slots in the proper order, left to right: rice first, then seaweed, then rice.
After pressing cook, you can drag the cooked food to the customer requesting it.
Each cat will display their order above their head and leave either:
         * Happy: +10 points                  or     * Unhappy: -5 points"
metadata/_edit_use_anchors_ = true

